generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Agents (utilisateurs internes de l'application)
// ---------------------------------------------------------------------------

enum AgentRole {
  ADMIN
  AGENT
}

// Toute première connexion Google crée un agent en attente : il peut se
// connecter mais n'accède à rien tant qu'un admin n'a pas tranché depuis
// /agents. REJECTED bloque la reconnexion (comme isActive à false, mais sans
// avoir jamais eu accès).
enum AgentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Agent {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      AgentRole @default(AGENT)
  avatarUrl String?
  isActive  Boolean   @default(true)

  approvalStatus AgentApprovalStatus @default(PENDING)
  approvalDecidedAt DateTime?

  // Permissions fines, indépendantes du rôle ADMIN/AGENT (qui régit l'accès
  // aux paramètres) : un agent "lecture seule" ne peut ni répondre ni modifier
  // un ticket ; un agent dont les réponses nécessitent validation voit ses
  // emails sortants bloqués en attente d'un agent habilité à les approuver.
  canRespond       Boolean @default(true)
  requiresApproval Boolean @default(false)
  canApprove       Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  assignedTickets  Ticket[]  @relation("TicketAssignee")
  messages         Message[]
  approvedMessages Message[] @relation("MessageApprovedBy")
  groups           Group[]

  notifications     Notification[] @relation("NotificationRecipient")
  sentNotifications Notification[] @relation("NotificationActor")

  // Signatures qui lui sont nominativement assignées (voir EmailSignature).
  signatures EmailSignature[]

  // Admin ayant approuvé/refusé ce compte (null pour les comptes créés avant
  // le workflow d'approbation).
  approvalDecidedBy   Agent?  @relation("AgentApprovalDecidedBy", fields: [approvalDecidedById], references: [id])
  approvalDecidedById String?
  approvalDecisions   Agent[] @relation("AgentApprovalDecidedBy")

  @@index([approvalStatus])
  @@map("agents")
}

// Équipe d'agents (ex: "Support Papairis") rattachée à un ou plusieurs
// produits concernés — sert à pré-filtrer la liste des tickets pour ses
// membres. Un agent peut appartenir à plusieurs groupes.
model Group {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#71717a")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  Agent[]
  products TicketCategory[]

  @@map("groups")
}

// ---------------------------------------------------------------------------
// Clients (contacts finaux à l'origine des tickets)
// ---------------------------------------------------------------------------

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@map("clients")
}

// ---------------------------------------------------------------------------
// Paramétrage des tickets (100% administrable, aucune valeur en dur)
// ---------------------------------------------------------------------------

model TicketStatus {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#71717a")
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  isClosed  Boolean  @default(false)
  // Un seul statut peut porter ce flag — cible automatique du bouton
  // "Prendre en charge" sur un ticket (comme isDefault, géré en singleton).
  isInProgressDefault Boolean @default(false)
  // Idem pour le bouton "Clore ce ticket" — singleton, cible du statut de clôture.
  isCloseDefault Boolean @default(false)
  // Statut appliqué quand un client répond par email à un ticket déjà clos —
  // singleton comme les précédents. Sans flag posé, la réouverture retombe sur
  // le statut `isDefault` : un client qui relance ne doit jamais rester bloqué
  // derrière un ticket fermé que personne ne rouvre.
  isReopenDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  automationTriggers AutomationRule[] @relation("AutomationTriggerStatus")
  automationActions  AutomationRule[] @relation("AutomationActionStatus")

  @@map("ticket_statuses")
}

model TicketPriority {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#71717a")
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@map("ticket_priorities")
}

model TicketCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#71717a")
  order       Int      @default(0)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]
  groups  Group[]

  @@map("ticket_categories")
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  DROPDOWN
  CHECKBOX
}

model CustomField {
  id         String          @id @default(cuid())
  label      String
  key        String          @unique
  type       CustomFieldType
  options    Json? // liste de choix pour le type DROPDOWN, ex: ["Option A", "Option B"]
  helpText   String? // petit texte d'aide affiché sous le champ (widget + fiche ticket)
  autofillFromSourceUrl Boolean @default(false) // champs TEXT uniquement : pré-rempli avec l'URL de la page d'origine sur le widget
  isRequired Boolean         @default(false)
  order      Int             @default(0)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("custom_fields")
}

// ---------------------------------------------------------------------------
// Réponses prédéfinies
// ---------------------------------------------------------------------------

// Dimension du ticket sur laquelle une réponse prédéfinie peut être restreinte.
// Ajouter une dimension = ajouter une valeur ici PUIS une entrée dans le
// registre `FILTER_DIMENSIONS` de src/lib/canned-responses.ts. Le registre est
// le seul endroit du code qui sait ce que chaque valeur désigne : ni le
// formulaire de réglages ni le filtrage n'ont de liste en dur.
enum CannedResponseDimension {
  CATEGORY // produit concerné du ticket (TicketCategory)
  SOURCE // formulaire d'origine du ticket (Source)
  PRIORITY // priorité du ticket (TicketPriority)
  STATUS // statut courant du ticket (TicketStatus)
}

// Réponse type, insérée d'un clic dans la zone de rédaction d'un ticket. Le
// corps est du texte brut, comme `Message.content` : ce qui est écrit ici est
// exactement ce que l'agent verra apparaître dans son champ, à lui de le
// relire et de l'ajuster avant envoi.
//
// Les variables `{{client}}`, `{{agent}}`… sont remplies au moment de
// l'insertion avec le contexte du ticket ouvert — voir
// src/lib/canned-responses.ts.
model CannedResponse {
  id       String  @id @default(cuid())
  title    String  @unique
  body     String
  isActive Boolean @default(true)

  // Pré-remplit la zone de rédaction dès l'ouverture d'un ticket qu'elle
  // concerne, sans que l'agent aille la chercher dans la liste. Combiné aux
  // filtres, c'est ce qui permet un premier jet d'office : « statut = Nouveau »
  // + « produit = Papairis » et le message d'accueil est déjà là.
  //
  // Plusieurs réponses peuvent porter le drapeau : c'est la plus ciblée qui
  // gagne, voir `pickAutoInserted` dans src/lib/canned-responses.ts.
  autoInsert Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  filters CannedResponseFilter[]

  @@index([isActive])
  @@map("canned_responses")
}

// Une restriction : « cette réponse ne concerne que ces valeurs, sur cette
// dimension ». Aucune ligne pour une dimension = la réponse vaut pour toutes
// ses valeurs. Plusieurs lignes sur la même dimension se lisent comme un OU
// (l'une OU l'autre), deux dimensions différentes comme un ET — voir
// `matchesTicket`.
//
// `valueId` n'est volontairement pas une clé étrangère : c'est le prix de la
// modularité, une seule table portant les filtres de toutes les dimensions
// plutôt qu'une table de jointure par dimension. La contrepartie est assumée et
// traitée : l'existence est vérifiée à l'enregistrement, et une valeur
// supprimée entre-temps est signalée dans la liste des réponses au lieu de
// filtrer sur un identifiant fantôme.
model CannedResponseFilter {
  id        String                  @id @default(cuid())
  dimension CannedResponseDimension
  valueId   String

  response   CannedResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  responseId String

  @@unique([responseId, dimension, valueId])
  @@index([responseId])
  @@map("canned_response_filters")
}

// ---------------------------------------------------------------------------
// Tickets & fil de messages
// ---------------------------------------------------------------------------

enum TicketSource {
  WIDGET_PAPAIRIS
  EMAIL
  DIRECT
  PORTAL
}

// ---------------------------------------------------------------------------
// Sources de tickets & formulaires sur-mesure
// ---------------------------------------------------------------------------

// Point d'entrée administrable (widget embarqué dans un logiciel, formulaire
// web, application mobile…). Chaque source porte son propre formulaire public,
// servi par /widget?source=<slug>. `ticketSource` reste l'ancienne
// classification en enum, conservée pour les filtres et badges existants.
model Source {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  ticketSource TicketSource @default(WIDGET_PAPAIRIS)

  // --- Branding du formulaire ---
  // URL du logo / image d'en-tête : soit un visuel téléversé (servi par
  // /api/portal/assets/<id>), soit une URL externe saisie à la main.
  logoUrl String?

  // --- Contenu du formulaire ---
  formTitle       String  @default("Contacter le support")
  formDescription String?
  submitLabel     String  @default("Envoyer")
  successMessage  String?

  // --- Blocs standards, activables source par source ---
  showCategoryField Boolean @default(true)
  allowAttachments  Boolean @default(true)
  showBannerMessage Boolean @default(true) // bandeau global `widget_banner_message`
  // Les champs personnalisés globaux (CustomField) s'ajoutent aux champs
  // propres à la source. Désactivé, seuls les champs ci-dessous s'affichent.
  useGlobalCustomFields Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields  SourceField[]
  tickets Ticket[]

  @@map("sources")
}

enum SourceFieldType {
  TEXT
  TEXTAREA
  SELECT
  CHECKBOX
  FILE
  HEADER // pur habillage : titre de section, sans valeur saisie
}

// Champ du formulaire d'une source. `key` est dérivée du libellé à la création
// puis figée : c'est la clé sous laquelle la réponse est stockée dans
// `Ticket.metadata`, renommer le libellé ne doit pas orpheliner l'historique.
model SourceField {
  id          String          @id @default(cuid())
  type        SourceFieldType
  label       String
  key         String
  placeholder String?
  helpText    String?
  isRequired  Boolean         @default(false)
  options     Json? // liste de choix pour le type SELECT, ex: ["Option A", "Option B"]
  order       Int             @default(0)

  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId String

  @@unique([sourceId, key])
  @@index([sourceId])
  @@map("source_fields")
}

model Ticket {
  id          String       @id @default(cuid())
  number      Int          @unique @default(autoincrement())
  subject     String
  description String
  source      TicketSource @default(DIRECT)
  sourceUrl   String? // page Papairis (ou autre) sur laquelle se trouvait le client
  metadata    Json         @default("{}") // valeurs des champs personnalisés (clé = CustomField.key) + contexte Papairis (clé "_papairis")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  closedAt    DateTime?

  // Activité non vue depuis la dernière ouverture par un agent (ex: réponse
  // client reçue par email). Mis à true par la synchro Gmail, remis à false
  // à l'ouverture de la fiche ticket — sert d'indicateur simple (pas de suivi
  // "lu" par agent individuel, volontairement, pour rester simple).
  hasUnreadActivity Boolean @default(false)

  // Threading email : identifiant de conversation Gmail et Message-ID RFC822 du
  // dernier tour (entrant ou sortant), utilisé pour l'en-tête In-Reply-To de la
  // prochaine réponse sortante.
  gmailThreadId  String?
  gmailMessageId String? @unique // id Gmail du 1er message entrant ayant créé ce ticket (dédoublonnage sync)
  emailMessageId String?

  status   TicketStatus @relation(fields: [statusId], references: [id])
  statusId String

  priority   TicketPriority @relation(fields: [priorityId], references: [id])
  priorityId String

  category   TicketCategory? @relation(fields: [categoryId], references: [id])
  categoryId String?

  assignee   Agent?  @relation("TicketAssignee", fields: [assigneeId], references: [id])
  assigneeId String?

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  // Source administrable à l'origine du ticket (null pour les tickets créés
  // avant les sources, par email ou à la main depuis le back-office).
  formSource   Source? @relation(fields: [formSourceId], references: [id])
  formSourceId String?

  // --- Fusion de doublons ---
  // Ticket dans lequel celui-ci a été fusionné. La fusion ne déplace ni ne
  // supprime rien : le ticket source garde son fil, son numéro et son fil Gmail
  // (indispensable pour continuer à répondre à SON client dans SA conversation),
  // il est simplement clos et rattaché à la cible, qui devient le seul endroit
  // où l'équipe travaille. C'est ce qui rend la fusion réversible.
  mergedInto    Ticket?   @relation("TicketMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedIntoId  String?
  mergedTickets Ticket[]  @relation("TicketMerge")
  mergedAt      DateTime?

  // Dernier passage de la détection de doublons. Sert d'anti-rejeu : sans lui,
  // chaque ouverture de fiche relancerait un appel facturé au fournisseur d'IA
  // pour recalculer le même résultat.
  duplicateScanAt DateTime?

  messages      Message[]
  attachments   Attachment[]
  notifications Notification[]

  duplicateSuggestions   TicketDuplicateSuggestion[] @relation("DuplicateSuggestionTicket")
  duplicateCandidateFor  TicketDuplicateSuggestion[] @relation("DuplicateSuggestionCandidate")

  @@index([mergedIntoId])
  @@index([formSourceId])
  @@index([statusId])
  @@index([priorityId])
  @@index([categoryId])
  @@index([assigneeId])
  @@index([clientId])
  @@index([gmailThreadId])
  @@map("tickets")
}

enum DuplicateSuggestionStatus {
  PENDING
  DISMISSED
  MERGED
}

// Rapprochement proposé entre deux tickets qui semblent traiter de la même
// demande. Persisté plutôt que recalculé à chaque affichage pour deux raisons :
// le calcul appelle un modèle de langage facturé au jeton, et un rapprochement
// écarté par un agent doit le rester (sans mémoire, la même proposition
// reviendrait à chaque ouverture de la fiche).
//
// `ticket` est le plus récent des deux — celui qu'un agent est en train de
// lire — et `candidate` le plus ancien : la fusion va donc, par défaut, dans le
// sens ticket → candidate, l'antériorité fixant le dossier de référence.
model TicketDuplicateSuggestion {
  id String @id @default(cuid())

  // 0 à 100. La part IA du score ; le pré-filtre lexical, lui, ne sert qu'à
  // choisir les candidats soumis au modèle.
  score  Int
  // Justification en une phrase, affichée telle quelle à l'agent : une
  // proposition de fusion sans motif n'est pas vérifiable.
  reason String

  status    DuplicateSuggestionStatus @default(PENDING)
  createdAt DateTime                  @default(now())
  decidedAt DateTime?

  ticket   Ticket @relation("DuplicateSuggestionTicket", fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  candidate   Ticket @relation("DuplicateSuggestionCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  @@unique([ticketId, candidateId])
  @@index([ticketId, status])
  @@map("ticket_duplicate_suggestions")
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  // Tour de conversation auquel le fichier était joint. Null = pièce jointe de
  // la demande initiale (formulaire public), affichée sous la description.
  // `SetNull` et pas `Cascade` : supprimer un message ne doit pas faire
  // disparaître une pièce jointe du dossier client.
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  messageId String?

  @@index([ticketId])
  @@index([messageId])
  @@map("attachments")
}

enum MessageAuthorType {
  AGENT
  CLIENT
  SYSTEM
}

// Absent (null) = pas de workflow de validation requis, comportement direct
// habituel. Ne s'applique qu'aux réponses publiques d'un agent dont
// `requiresApproval` est activé.
enum MessageApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Message {
  id         String            @id @default(cuid())
  content    String
  authorType MessageAuthorType
  // Note interne (non visible du client, pas d'envoi d'email) vs réponse
  // publique. Fait déjà office de "is_internal" — pas de champ dupliqué.
  isPrivate  Boolean           @default(false)
  emailSent  Boolean           @default(false) // réponse publique effectivement envoyée par email
  gmailMessageId String?       @unique // id Gmail du message entrant/sortant correspondant (dédoublonnage sync)

  approvalStatus MessageApprovalStatus?
  approvedAt     DateTime?

  createdAt  DateTime          @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  agent   Agent?  @relation(fields: [agentId], references: [id])
  agentId String?

  approvedBy   Agent?  @relation("MessageApprovedBy", fields: [approvedById], references: [id])
  approvedById String?

  attachments   Attachment[]
  notifications Notification[]

  @@index([ticketId])
  @@index([approvalStatus])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Notifications internes (mentions @agent dans les notes internes)
// ---------------------------------------------------------------------------

enum NotificationType {
  MENTION
  // Ticket confié à un agent (bouton d'assignation du panneau d'attributs).
  // Sans cette notification, une réassignation était totalement silencieuse :
  // le ticket changeait de main sans que personne ne l'apprenne.
  ASSIGNMENT
}

// Un agent mentionné en @ dans une note interne reçoit à la fois un email et
// une ligne ici, lue par la cloche du dashboard. `excerpt` fige un extrait de
// la note au moment du ping : la cloche reste lisible même si la note est
// réécrite ensuite.
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType @default(MENTION)
  excerpt   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  recipient   Agent  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String

  // Auteur du ping. Optionnel pour survivre à la suppression de son compte —
  // la notification reste consultable, sans nom d'auteur.
  actor   Agent?  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String?

  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String?

  @@index([recipientId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Intégration Gmail (une seule boîte support connectée à la fois)
// ---------------------------------------------------------------------------

model EmailAccount {
  id           String    @id @default(cuid())
  email        String    @unique
  accessToken  String
  refreshToken String
  tokenExpiry  DateTime?
  historyId    String? // curseur de synchronisation incrémentale Gmail
  connectedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("email_accounts")
}

// ---------------------------------------------------------------------------
// Paramètres généraux (clé / valeur)
// ---------------------------------------------------------------------------

// Modèle d'email envoyé par le bouton "Clore ce ticket" — singleton (une seule
// ligne, comme EmailAccount). Pas de ligne = pas d'email de clôture envoyé.
model TicketClosureTemplate {
  id        String   @id @default(cuid())
  bodyHtml  String
  updatedAt DateTime @updatedAt

  @@map("ticket_closure_template")
}

// Accusé de réception envoyé au client dès la création d'un ticket depuis un
// formulaire public (portail, widget, sources) — singleton comme
// TicketClosureTemplate. Pas de ligne = aucun accusé envoyé.
model TicketAcknowledgementTemplate {
  id        String   @id @default(cuid())
  bodyHtml  String
  updatedAt DateTime @updatedAt

  @@map("ticket_acknowledgement_template")
}

// Habillage HTML commun à TOUS les emails sortants (en-tête, carte, pied de
// page) — singleton comme les deux modèles ci-dessus. Le contenu propre à
// chaque email s'insère dedans par emplacements ({{content}}, {{headline}}…),
// voir src/lib/email-layout.ts. Pas de ligne = gabarit par défaut du code.
model EmailLayoutTemplate {
  id        String   @id @default(cuid())
  html      String
  updatedAt DateTime @updatedAt

  @@map("email_layout_template")
}

// À qui s'applique une signature.
enum SignatureScope {
  ALL_AGENTS // toute l'équipe, sauf les agents couverts par une signature nominative
  SPECIFIC_AGENTS // uniquement les agents listés dans `agents`
}

// Signature ajoutée en bas des réponses envoyées au client par email, sous le
// corps du message et avant l'historique de la conversation. Le contenu porte
// des variables ({{prenom}}, {{nom}}…) remplies au moment de l'envoi avec
// l'identité de l'agent auteur de la réponse — voir src/lib/signature.ts.
//
// Contrairement aux modèles d'email ci-dessus, ce n'est pas un singleton : une
// signature peut valoir pour toute l'équipe ou pour quelques agents seulement.
// Une signature nominative l'emporte sur celle de toute l'équipe, et un agent
// n'est jamais couvert par deux signatures actives à la fois (garanti à
// l'enregistrement, voir src/lib/actions/signatures.ts).
model EmailSignature {
  id       String         @id @default(cuid())
  name     String         @unique
  bodyHtml String
  scope    SignatureScope @default(ALL_AGENTS)
  isActive Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Agents concernés quand `scope` vaut SPECIFIC_AGENTS. Ignoré (et vidé à
  // l'enregistrement) pour une signature de toute l'équipe.
  agents Agent[]

  @@index([isActive])
  @@map("email_signatures")
}

enum PortalColorMode {
  LIGHT
  DARK
}

// Disposition de la barre de navigation du portail.
enum PortalNavVariant {
  LOGO_LEFT // logo à gauche, liens + CTA à droite
  LINKS_CENTER // logo à gauche, liens centrés, CTA à droite
  CENTERED // logo centré, liens sur une seconde ligne centrée
  MINIMAL // logo à gauche, seulement le CTA à droite
}

enum PortalAlign {
  LEFT
  CENTER
}

// Portail public (accueil, FAQ, création de ticket) — singleton, comme
// EmailAccount et TicketClosureTemplate. Pas de ligne = toutes les valeurs par
// défaut ci-dessous (voir aussi PORTAL_DEFAULTS dans src/lib/portal-theme.ts,
// qui doit rester aligné avec ces @default).
model PortalSettings {
  id String @id @default(cuid())

  // --- Identité ---
  siteName        String  @default("Ideeri")
  tagline         String? @default("Support")
  showTagline     Boolean @default(true)
  showLogo        Boolean @default(true)
  showSiteName    Boolean @default(false)
  logoAssetId     String?
  logoHeight      Int     @default(24) // hauteur d'affichage du logo, en px
  faviconAssetId  String?
  metaTitle       String?
  metaDescription String?

  // --- Apparence --- (couleurs en hex ; null = valeur par défaut du thème)
  colorMode              PortalColorMode @default(LIGHT)
  primaryColor           String          @default("#ecb300")
  primaryForegroundColor String          @default("#0a0a0a")
  backgroundColor        String?
  foregroundColor        String?
  cardColor              String?
  borderColor            String?
  mutedColor             String?
  mutedForegroundColor   String?
  radius                 Float           @default(0.5) // en rem
  fontSans               String          @default("inter")
  fontDisplay            String          @default("fraunces")

  // --- Navigation --- navLinks : [{ label, href, newTab }]
  navVariant    PortalNavVariant @default(LOGO_LEFT)
  navSticky     Boolean          @default(true)
  navBlur       Boolean          @default(true)
  navBordered   Boolean          @default(true)
  navShowFaq    Boolean          @default(true)
  navShowLogin  Boolean          @default(true)
  navCtaEnabled Boolean          @default(true)
  navCtaLabel   String           @default("Créer un ticket")
  navLinks      Json             @default("[]")

  // --- Hero ---
  heroEnabled  Boolean     @default(true)
  heroEyebrow  String?     @default("Centre d'aide Ideeri")
  heroTitle    String?     @default("Comment pouvons-nous vous aider ?")
  introMessage String? // sous-titre du hero, aussi réutilisé sur /nouveau-ticket
  heroAlign    PortalAlign @default(CENTER)
  heroGlow     Boolean     @default(true)

  // --- Cartes « deux chemins » --- (icônes : noms lucide de PORTAL_ICONS)
  cardsEnabled    Boolean @default(true)
  faqCardTitle    String  @default("Consulter la FAQ")
  faqCardText     String  @default("Les réponses aux questions les plus fréquentes sur nos logiciels, classées par produit.")
  faqCardIcon     String  @default("BookOpen")
  ticketCardTitle String  @default("Créer un ticket")
  ticketCardText  String  @default("Une question précise ou un problème ? Décrivez votre demande, nous vous répondons par email.")
  ticketCardIcon  String  @default("MessagesSquare")

  // --- Section FAQ ---
  faqEnabled       Boolean @default(true)
  faqEyebrow       String? @default("Foire aux questions")
  faqTitle         String? @default("Trouvez votre réponse")
  faqSearchEnabled Boolean @default(true)

  // --- Pied de page --- footerLinks : [{ label, href, newTab }]
  footerEnabled Boolean @default(true)
  footerText    String? @default("Support Ideeri")
  footerIcon    String  @default("LifeBuoy")
  footerLinks   Json    @default("[]")

  updatedAt DateTime @updatedAt

  @@map("portal_settings")
}

// Visuels publics (logo et favicon du portail, en-tête des formulaires de
// source), stockés en base comme KnowledgeArticleImage — pas de disque
// persistant en production — et servis par /api/portal/assets/[id].
model PortalAsset {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@map("portal_assets")
}

model GlobalSetting {
  key         String   @id
  value       String
  label       String
  description String?
  multiline   Boolean  @default(false) // affiche un textarea plutôt qu'un input dans /settings/general
  updatedAt   DateTime @updatedAt

  @@map("global_settings")
}

// ---------------------------------------------------------------------------
// Base de connaissances (FAQ) & modèles d'articles
// ---------------------------------------------------------------------------

enum KnowledgeArticleStatus {
  DRAFT
  PUBLISHED
}

model KnowledgeCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles KnowledgeArticle[]

  @@map("knowledge_categories")
}

model KnowledgeArticle {
  id          String                 @id @default(cuid())
  title       String
  slug        String                 @unique
  excerpt     String?
  content     String
  status      KnowledgeArticleStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  category   KnowledgeCategory? @relation(fields: [categoryId], references: [id])
  categoryId String?

  // Lien de partage optionnel — absent tant que l'auteur n'a pas activé le
  // partage. `shareScope` choisit au cas par cas si le lien est consultable
  // sans connexion (PUBLIC) ou seulement par un agent connecté (INTERNAL).
  shareToken String?             @unique
  shareScope KnowledgeShareScope?

  @@index([categoryId])
  @@index([status])
  @@map("knowledge_articles")
}

enum KnowledgeShareScope {
  PUBLIC
  INTERNAL
}

// Images insérées dans le contenu riche d'un article — stockées en base
// comme les pièces jointes de ticket (pas de stockage fichier persistant
// simple sur Railway). Pas de FK vers l'article : une image reste valide même
// déplacée entre articles ou collée avant la première sauvegarde.
model KnowledgeArticleImage {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@map("knowledge_article_images")
}

// Trames réutilisables pour rédiger un nouvel article plus vite (pas liées à
// un article précis : appliquer un modèle copie simplement son contenu dans
// l'éditeur, l'agent part de là).
model ArticleTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("article_templates")
}

// ---------------------------------------------------------------------------
// Automatisations (ex : fermeture automatique des tickets inactifs)
// ---------------------------------------------------------------------------

model AutomationRule {
  id        String  @id @default(cuid())
  name      String
  isActive  Boolean @default(true)

  // Délai d'inactivité (basé sur `Ticket.updatedAt`) avant que la règle ne
  // s'applique à un ticket dans le statut déclencheur.
  delayDays Int @default(3)

  triggerStatus   TicketStatus @relation("AutomationTriggerStatus", fields: [triggerStatusId], references: [id])
  triggerStatusId String

  actionStatus   TicketStatus @relation("AutomationActionStatus", fields: [actionStatusId], references: [id])
  actionStatusId String

  addNote     Boolean @default(true)
  noteContent String  @default("Ticket automatiquement fermé après inactivité.")

  sendEmail    Boolean @default(false)
  emailContent String?

  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("automation_rules")
}
