generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Agents (utilisateurs internes de l'application)
// ---------------------------------------------------------------------------

enum AgentRole {
  ADMIN
  AGENT
}

// Toute première connexion Google crée un agent en attente : il peut se
// connecter mais n'accède à rien tant qu'un admin n'a pas tranché depuis
// /agents. REJECTED bloque la reconnexion (comme isActive à false, mais sans
// avoir jamais eu accès).
enum AgentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Agent {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      AgentRole @default(AGENT)
  avatarUrl String?
  isActive  Boolean   @default(true)

  approvalStatus    AgentApprovalStatus @default(PENDING)
  approvalDecidedAt DateTime?

  // Voir `Client.anonymizedAt` : même geste, sur un compte de l'équipe. Le
  // compte survit à son identité parce que le journal d'audit s'y rattache par
  // `actorId` — le détruire ferait perdre le regroupement des traces d'une même
  // personne, alors que le journal doit être conservé. Un compte anonymisé est
  // aussi désactivé et refusé : son email n'existe plus, une reconnexion Google
  // créerait de toute façon un nouveau compte, ce qui est le comportement voulu.
  anonymizedAt DateTime?

  // Permissions fines : les clés du registre `src/lib/permissions.ts` accordées
  // à ce compte (« tickets.respond », « audit.view »…). Volontairement des
  // chaînes libres et non un enum Postgres — ajouter une permission ne doit
  // coûter qu'une entrée dans le registre, pas une migration. La contrepartie
  // est assumée et traitée : les clés inconnues sont écartées à la lecture par
  // `normalizePermissions`, elles n'autorisent donc jamais rien.
  //
  // Vide pour un ADMIN, et ce n'est pas un oubli : le rôle vaut « toutes les
  // permissions », y compris celles qui n'existent pas encore. Ne rien stocker
  // pour lui évite d'avoir à le rattraper à chaque ajout au registre.
  permissions String[] @default([])

  // Contrainte, et non permission : les réponses publiques de cet agent partent
  // en attente de validation au lieu d'être envoyées. Ce n'est pas un droit
  // qu'on accorde, c'est une retenue qu'on impose — d'où sa place hors du
  // registre.
  requiresApproval Boolean @default(false)

  // --- Emails d'équipe reçus par cet agent ---
  // Activés par défaut : un agent qu'on ajoute doit être au courant de ce qui
  // arrive sur ses dossiers sans avoir à réclamer un réglage. Ils se coupent
  // depuis sa fiche, un par un — couper l'ensemble d'un coup reviendrait à
  // pousser l'intéressé à filtrer l'expéditeur dans sa boîte, et à ne plus rien
  // lire du tout, y compris les mentions.
  //
  // Les mentions « @Prénom » ne sont volontairement PAS débrayables : citer
  // quelqu'un nommément est une adresse directe, pas une diffusion.
  notifyOnAssignment Boolean @default(true)
  notifyOnNewTicket  Boolean @default(true)
  notifyOnSlaWarning Boolean @default(true)
  notifyOnAutomation Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTickets   Ticket[]         @relation("TicketAssignee")
  automationActions AutomationRule[] @relation("AutomationActionAssignee")
  messages          Message[]
  approvedMessages  Message[]        @relation("MessageApprovedBy")
  groups            Group[]

  notifications     Notification[] @relation("NotificationRecipient")
  sentNotifications Notification[] @relation("NotificationActor")

  // Signatures qui lui sont nominativement assignées (voir EmailSignature).
  signatures EmailSignature[]

  auditEntries AuditLog[]

  presences TicketPresence[]

  // Admin ayant approuvé/refusé ce compte (null pour les comptes créés avant
  // le workflow d'approbation).
  approvalDecidedBy   Agent?  @relation("AgentApprovalDecidedBy", fields: [approvalDecidedById], references: [id])
  approvalDecidedById String?
  approvalDecisions   Agent[] @relation("AgentApprovalDecidedBy")

  @@index([approvalStatus])
  @@map("agents")
}

// Équipe d'agents (ex: "Support Papairis") rattachée à un ou plusieurs
// produits concernés — sert à pré-filtrer la liste des tickets pour ses
// membres. Un agent peut appartenir à plusieurs groupes.
model Group {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#71717a")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  Agent[]
  products TicketCategory[]

  automationAlerts AutomationRule[] @relation("AutomationNotifyGroup")

  @@map("groups")
}

// ---------------------------------------------------------------------------
// Clients (contacts finaux à l'origine des tickets)
// ---------------------------------------------------------------------------

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Date à laquelle l'identité de ce contact a été remplacée par un pseudonyme
  // (droit à l'effacement, art. 17). La fiche RESTE : ses tickets, leur
  // historique et le journal continuent de se lire, seul le « qui » a disparu.
  // Renseignée = ne plus jamais présenter cette fiche comme un contact
  // joignable, et ne pas la proposer au rapprochement par email (l'adresse
  // stockée est en `.invalid`, donc inatteignable par construction).
  anonymizedAt DateTime?

  // --- Fusion de fiches en doublon ---
  // Fiche dans laquelle celle-ci a été fusionnée. Même modèle que la fusion de
  // tickets, et pour la même raison : la fusion ne DÉTRUIT rien, elle est donc
  // réversible. La fiche absorbée garde son nom, son adresse et sa date de
  // création ; elle cesse simplement d'être un contact à part entière.
  //
  // Cette survivance n'est pas qu'une précaution : c'est ce qui fait tenir la
  // fusion dans le temps. La personne continue d'écrire depuis l'adresse
  // absorbée, et c'est cette fiche-là que la résolution d'un email entrant
  // retrouve — elle suit alors le lien jusqu'au contact actif (voir
  // `resolveTicketClient`). Sans elle, le prochain email recréerait la fiche que
  // l'agent venait de faire disparaître.
  //
  // `SetNull` plutôt que `Cascade` : supprimer le contact actif (droit à
  // l'effacement) ne doit pas emporter les fiches qu'il avait absorbées, qui
  // portent l'identité d'une AUTRE personne le cas échéant — elles redeviennent
  // simplement autonomes.
  mergedInto    Client?   @relation("ClientMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedIntoId  String?
  mergedClients Client[]  @relation("ClientMerge")
  mergedAt      DateTime?

  tickets Ticket[]

  @@index([mergedIntoId])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// Paramétrage des tickets (100% administrable, aucune valeur en dur)
// ---------------------------------------------------------------------------

model TicketStatus {
  id                  String  @id @default(cuid())
  name                String  @unique
  color               String  @default("#71717a")
  order               Int     @default(0)
  isDefault           Boolean @default(false)
  isClosed            Boolean @default(false)
  // Un seul statut peut porter ce flag — cible automatique du bouton
  // "Prendre en charge" sur un ticket (comme isDefault, géré en singleton).
  isInProgressDefault Boolean @default(false)
  // Idem pour le bouton "Clore ce ticket" — singleton, cible du statut de clôture.
  isCloseDefault      Boolean @default(false)
  // Statut appliqué quand un client répond par email à un ticket déjà clos —
  // singleton comme les précédents. Sans flag posé, la réouverture retombe sur
  // le statut `isDefault` : un client qui relance ne doit jamais rester bloqué
  // derrière un ticket fermé que personne ne rouvre.
  isReopenDefault     Boolean @default(false)

  // Suspend l'horloge SLA tant que le ticket porte ce statut (typiquement « En
  // attente du client »). Désactivé partout par défaut : c'est le réglage le
  // plus lisible — l'échéance affichée est alors la vraie échéance, posée à la
  // création et jamais déplacée. Voir src/lib/sla.ts.
  pausesSla Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  automationTriggers AutomationRule[] @relation("AutomationTriggerStatus")
  automationActions  AutomationRule[] @relation("AutomationActionStatus")

  @@map("ticket_statuses")
}

model TicketPriority {
  id        String  @id @default(cuid())
  name      String  @unique
  color     String  @default("#71717a")
  order     Int     @default(0)
  isDefault Boolean @default(false)

  // --- Engagements de délai (SLA) ---
  // Deux délais distincts, en minutes, comptés depuis l'arrivée du ticket :
  // le temps qu'on se donne pour ADRESSER un premier mot au client, et celui
  // qu'on se donne pour CLORE son dossier. C'est la priorité qui les porte —
  // « urgent en 2 h, faible en 2 jours » est la formulation même de l'engagement.
  //
  // `null` = aucun engagement à ce niveau de priorité : le ticket n'aura pas
  // d'échéance et ne pourra jamais apparaître en retard. C'est la valeur de
  // départ de toutes les priorités, y compris celles déjà en base : tant qu'un
  // administrateur n'a rien saisi dans Paramètres > SLA, l'application
  // n'invente aucun engagement à la place de l'équipe.
  firstResponseMinutes Int?
  resolutionMinutes    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  automationActions AutomationRule[] @relation("AutomationActionPriority")

  @@map("ticket_priorities")
}

model TicketCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  color       String  @default("#71717a")
  order       Int     @default(0)
  isDefault   Boolean @default(false)

  // Mots qui, dans un email entrant, désignent ce produit — un email n'a pas de
  // liste déroulante, le tri à l'arrivée n'a que ce que le client a écrit. Se
  // saisissent produit par produit depuis /settings/categories : une liste en
  // dur dans le code ne suivait pas les renommages faits depuis cet écran.
  // Liste vide = ce produit n'est jamais posé automatiquement.
  // Voir `detectProductFromEmail`.
  emailKeywords String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
  groups  Group[]

  @@map("ticket_categories")
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  DROPDOWN
  CHECKBOX
}

model CustomField {
  id                    String          @id @default(cuid())
  label                 String
  key                   String          @unique
  type                  CustomFieldType
  options               Json? // liste de choix pour le type DROPDOWN, ex: ["Option A", "Option B"]
  helpText              String? // petit texte d'aide affiché sous le champ (widget + fiche ticket)
  autofillFromSourceUrl Boolean         @default(false) // champs TEXT uniquement : pré-rempli avec l'URL de la page d'origine sur le widget
  isRequired            Boolean         @default(false)
  order                 Int             @default(0)
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("custom_fields")
}

// ---------------------------------------------------------------------------
// Réponses prédéfinies
// ---------------------------------------------------------------------------

// Dimension du ticket sur laquelle une réponse prédéfinie peut être restreinte.
// Ajouter une dimension = ajouter une valeur ici PUIS une entrée dans le
// registre `FILTER_DIMENSIONS` de src/lib/canned-responses.ts. Le registre est
// le seul endroit du code qui sait ce que chaque valeur désigne : ni le
// formulaire de réglages ni le filtrage n'ont de liste en dur.
enum CannedResponseDimension {
  CATEGORY // produit concerné du ticket (TicketCategory)
  SOURCE // formulaire d'origine du ticket (Source)
  PRIORITY // priorité du ticket (TicketPriority)
  STATUS // statut courant du ticket (TicketStatus)
}

// Réponse type, insérée d'un clic dans la zone de rédaction d'un ticket. Le
// corps est du texte brut, comme `Message.content` : ce qui est écrit ici est
// exactement ce que l'agent verra apparaître dans son champ, à lui de le
// relire et de l'ajuster avant envoi.
//
// Les variables `{{client}}`, `{{agent}}`… sont remplies au moment de
// l'insertion avec le contexte du ticket ouvert — voir
// src/lib/canned-responses.ts.
model CannedResponse {
  id       String  @id @default(cuid())
  title    String  @unique
  body     String
  isActive Boolean @default(true)

  // Pré-remplit la zone de rédaction dès l'ouverture d'un ticket qu'elle
  // concerne, sans que l'agent aille la chercher dans la liste. Combiné aux
  // filtres, c'est ce qui permet un premier jet d'office : « statut = Nouveau »
  // + « produit = Papairis » et le message d'accueil est déjà là.
  //
  // Plusieurs réponses peuvent porter le drapeau : c'est la plus ciblée qui
  // gagne, voir `pickAutoInserted` dans src/lib/canned-responses.ts.
  autoInsert Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  filters CannedResponseFilter[]

  @@index([isActive])
  @@map("canned_responses")
}

// Une restriction : « cette réponse ne concerne que ces valeurs, sur cette
// dimension ». Aucune ligne pour une dimension = la réponse vaut pour toutes
// ses valeurs. Plusieurs lignes sur la même dimension se lisent comme un OU
// (l'une OU l'autre), deux dimensions différentes comme un ET — voir
// `matchesTicket`.
//
// `valueId` n'est volontairement pas une clé étrangère : c'est le prix de la
// modularité, une seule table portant les filtres de toutes les dimensions
// plutôt qu'une table de jointure par dimension. La contrepartie est assumée et
// traitée : l'existence est vérifiée à l'enregistrement, et une valeur
// supprimée entre-temps est signalée dans la liste des réponses au lieu de
// filtrer sur un identifiant fantôme.
model CannedResponseFilter {
  id        String                  @id @default(cuid())
  dimension CannedResponseDimension
  valueId   String

  response   CannedResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  responseId String

  @@unique([responseId, dimension, valueId])
  @@index([responseId])
  @@map("canned_response_filters")
}

// ---------------------------------------------------------------------------
// Tickets & fil de messages
// ---------------------------------------------------------------------------

enum TicketSource {
  WIDGET_PAPAIRIS
  EMAIL
  DIRECT
  PORTAL
}

// ---------------------------------------------------------------------------
// Sources de tickets & formulaires sur-mesure
// ---------------------------------------------------------------------------

// Point d'entrée administrable (widget embarqué dans un logiciel, formulaire
// web, application mobile…). Chaque source porte son propre formulaire public,
// servi par /widget?source=<slug>. `ticketSource` reste l'ancienne
// classification en enum, conservée pour les filtres et badges existants.
model Source {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  ticketSource TicketSource @default(WIDGET_PAPAIRIS)

  // --- Branding du formulaire ---
  // URL du logo / image d'en-tête : soit un visuel téléversé (servi par
  // /api/portal/assets/<id>), soit une URL externe saisie à la main.
  logoUrl String?

  // --- Contenu du formulaire ---
  formTitle       String  @default("Contacter le support")
  formDescription String?
  submitLabel     String  @default("Envoyer")
  successMessage  String?

  // --- Blocs standards, activables source par source ---
  showCategoryField     Boolean @default(true)
  allowAttachments      Boolean @default(true)
  showBannerMessage     Boolean @default(true) // bandeau global `widget_banner_message`
  // Les champs personnalisés globaux (CustomField) s'ajoutent aux champs
  // propres à la source. Désactivé, seuls les champs ci-dessous s'affichent.
  useGlobalCustomFields Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields  SourceField[]
  tickets Ticket[]

  @@map("sources")
}

enum SourceFieldType {
  TEXT
  TEXTAREA
  SELECT
  CHECKBOX
  FILE
  HEADER // pur habillage : titre de section, sans valeur saisie
}

// Champ du formulaire d'une source. `key` est dérivée du libellé à la création
// puis figée : c'est la clé sous laquelle la réponse est stockée dans
// `Ticket.metadata`, renommer le libellé ne doit pas orpheliner l'historique.
model SourceField {
  id          String          @id @default(cuid())
  type        SourceFieldType
  label       String
  key         String
  placeholder String?
  helpText    String?
  isRequired  Boolean         @default(false)
  options     Json? // liste de choix pour le type SELECT, ex: ["Option A", "Option B"]
  order       Int             @default(0)

  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId String

  @@unique([sourceId, key])
  @@index([sourceId])
  @@map("source_fields")
}

model Ticket {
  id          String       @id @default(cuid())
  number      Int          @unique @default(autoincrement())
  subject     String
  description String
  source      TicketSource @default(DIRECT)
  sourceUrl   String? // page Papairis (ou autre) sur laquelle se trouvait le client
  metadata    Json         @default("{}") // valeurs des champs personnalisés (clé = CustomField.key) + contexte Papairis (clé "_papairis")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  closedAt    DateTime?

  // Activité non vue depuis la dernière ouverture par un agent (ex: réponse
  // client reçue par email). Mis à true par la synchro Gmail, remis à false
  // à l'ouverture de la fiche ticket — sert d'indicateur simple (pas de suivi
  // "lu" par agent individuel, volontairement, pour rester simple).
  hasUnreadActivity Boolean @default(false)

  // --- Horloge SLA ---
  // Une horloge PAR TICKET, et non une statistique de fin de mois : les deux
  // échéances sont calculées à la création, à partir de la priorité et du
  // calendrier configuré, puis stockées. Stockées, et non recalculées à
  // l'affichage, pour deux raisons : la liste « SLA en retard » se filtre alors
  // en SQL (`firstResponseDueAt < now()`) au lieu de charger toute la file en
  // mémoire, et l'engagement pris à l'arrivée du ticket ne se réécrit pas tout
  // seul quand les réglages changent trois mois plus tard.
  //
  // `null` = aucun engagement (priorité sans délai configuré, ou ticket créé
  // avant la mise en service du SLA) : ce ticket n'apparaîtra jamais en retard.
  firstResponseDueAt DateTime?
  resolutionDueAt    DateTime?

  // Premier message public d'un agent au client. C'est ce qui ARRÊTE l'horloge
  // de première réponse — ni l'accusé de réception automatique ni une note
  // interne ne comptent, aucun des deux n'étant une réponse d'un agent au
  // client. La date de résolution, elle, est déjà portée par `closedAt`.
  firstRespondedAt DateTime?

  // Suspension de l'horloge (statuts marqués `pausesSla`). Deux champs et non
  // un : `slaPausedAt` dit depuis quand l'horloge est arrêtée — un ticket en
  // pause n'est jamais compté en retard — et `slaPausedMs` accumule le temps
  // déjà gelé, dont les échéances sont décalées à chaque reprise. Sans ce
  // cumul, un ticket suspendu deux fois perdrait la première pause.
  slaPausedAt DateTime?
  slaPausedMs Int       @default(0)

  // Anti-rejeu de l'alerte « échéance imminente » : le balayage tourne toutes
  // les quelques minutes et retrouverait le même ticket à chaque passage. Un
  // horodatage PAR HORLOGE, et non un seul drapeau : sans ça, un ticket alerté
  // sur sa première réponse ne le serait jamais sur sa résolution.
  //
  // Remis à zéro quand l'échéance correspondante est recalculée (changement de
  // priorité, réouverture) : c'est une nouvelle échéance, elle mérite son
  // avertissement.
  firstResponseWarnedAt DateTime?
  resolutionWarnedAt    DateTime?

  // Threading email : identifiant de conversation Gmail et Message-ID RFC822 du
  // dernier tour (entrant ou sortant), utilisé pour l'en-tête In-Reply-To de la
  // prochaine réponse sortante.
  gmailThreadId  String?
  gmailMessageId String? @unique // id Gmail du 1er message entrant ayant créé ce ticket (dédoublonnage sync)
  emailMessageId String?

  status   TicketStatus @relation(fields: [statusId], references: [id])
  statusId String

  priority   TicketPriority @relation(fields: [priorityId], references: [id])
  priorityId String

  category   TicketCategory? @relation(fields: [categoryId], references: [id])
  categoryId String?

  assignee   Agent?  @relation("TicketAssignee", fields: [assigneeId], references: [id])
  assigneeId String?

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  // Source administrable à l'origine du ticket (null pour les tickets créés
  // avant les sources, par email ou à la main depuis le back-office).
  formSource   Source? @relation(fields: [formSourceId], references: [id])
  formSourceId String?

  // --- Fusion de doublons ---
  // Ticket dans lequel celui-ci a été fusionné. La fusion ne déplace ni ne
  // supprime rien : le ticket source garde son fil, son numéro et son fil Gmail
  // (indispensable pour continuer à répondre à SON client dans SA conversation),
  // il est simplement clos et rattaché à la cible, qui devient le seul endroit
  // où l'équipe travaille. C'est ce qui rend la fusion réversible.
  mergedInto    Ticket?   @relation("TicketMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedIntoId  String?
  mergedTickets Ticket[]  @relation("TicketMerge")
  mergedAt      DateTime?

  // Dernier passage de la détection de doublons. Sert d'anti-rejeu : sans lui,
  // chaque ouverture de fiche relancerait un appel facturé au fournisseur d'IA
  // pour recalculer le même résultat.
  duplicateScanAt DateTime?

  messages      Message[]
  attachments   Attachment[]
  notifications Notification[]
  auditEntries  AuditLog[]

  duplicateSuggestions  TicketDuplicateSuggestion[] @relation("DuplicateSuggestionTicket")
  duplicateCandidateFor TicketDuplicateSuggestion[] @relation("DuplicateSuggestionCandidate")

  presences TicketPresence[]

  @@index([mergedIntoId])
  @@index([formSourceId])
  @@index([statusId])
  @@index([priorityId])
  @@index([categoryId])
  @@index([assigneeId])
  @@index([clientId])
  @@index([gmailThreadId])
  // Lecture de la vue « SLA en retard » et de son compteur, rejouée à chaque
  // affichage de la file : sans index, chaque passage balaierait toute la table.
  @@index([firstResponseDueAt])
  @@index([resolutionDueAt])
  @@map("tickets")
}

enum DuplicateSuggestionStatus {
  PENDING
  DISMISSED
  MERGED
}

// Rapprochement proposé entre deux tickets qui semblent traiter de la même
// demande. Persisté plutôt que recalculé à chaque affichage pour deux raisons :
// le calcul appelle un modèle de langage facturé au jeton, et un rapprochement
// écarté par un agent doit le rester (sans mémoire, la même proposition
// reviendrait à chaque ouverture de la fiche).
//
// `ticket` est le plus récent des deux — celui qu'un agent est en train de
// lire — et `candidate` le plus ancien : la fusion va donc, par défaut, dans le
// sens ticket → candidate, l'antériorité fixant le dossier de référence.
//
// Le `@@unique` ci-dessous ne porte que sur le couple ORDONNÉ. L'unicité du
// rapprochement lui-même — (A, B) et (B, A) désignent le même — est garantie par
// un index sur expression que Prisma ne sait pas décrire dans un schéma,
// installé par la migration
// `20260806120000_duplicate_suggestion_unordered_pair`. Insérer le miroir d'un
// rapprochement existant lève donc une erreur d'unicité : c'est voulu.
model TicketDuplicateSuggestion {
  id String @id @default(cuid())

  // 0 à 100. La part IA du score ; le pré-filtre lexical, lui, ne sert qu'à
  // choisir les candidats soumis au modèle.
  score  Int
  // Justification en une phrase, affichée telle quelle à l'agent : une
  // proposition de fusion sans motif n'est pas vérifiable.
  reason String

  status    DuplicateSuggestionStatus @default(PENDING)
  createdAt DateTime                  @default(now())
  decidedAt DateTime?

  ticket   Ticket @relation("DuplicateSuggestionTicket", fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  candidate   Ticket @relation("DuplicateSuggestionCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  @@unique([ticketId, candidateId])
  @@index([ticketId, status])
  @@map("ticket_duplicate_suggestions")
}

// État de l'analyse antivirus d'un fichier stocké (voir `src/lib/antivirus.ts`).
//
// PENDING est la valeur par défaut parce qu'un fichier entre en base même quand
// le scanner est injoignable : refuser le téléversement ferait tomber la
// création de tickets du portail public à chaque redémarrage du démon. La
// contrepartie est que PENDING doit être repris — c'est le rôle de
// /api/cron/antivirus.
//
// INFECTED n'est jamais posé à l'entrée : à l'entrée, un fichier reconnu
// malveillant est refusé et n'est pas stocké. Ce statut ne peut donc venir que
// d'un rescan, quand une signature publiée après coup rattrape un fichier déjà
// en base. Les octets sont alors purgés (voir `antivirus-rescan.ts`) : la ligne
// ne survit que comme trace, jamais comme charge utile.
enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  scanStatus    FileScanStatus @default(PENDING)
  scanSignature String?
  scannedAt     DateTime?

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  // Tour de conversation auquel le fichier était joint. Null = pièce jointe de
  // la demande initiale (formulaire public), affichée sous la description.
  // `SetNull` et pas `Cascade` : supprimer un message ne doit pas faire
  // disparaître une pièce jointe du dossier client.
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  messageId String?

  @@index([ticketId])
  @@index([messageId])
  // Lecture du cron de rescan : « quels fichiers restent à analyser ? », toutes
  // fiches confondues. Sans cet index il balaierait la table entière, qui porte
  // les octets des pièces jointes.
  @@index([scanStatus])
  @@map("attachments")
}

enum MessageAuthorType {
  AGENT
  CLIENT
  SYSTEM
}

// Absent (null) = pas de workflow de validation requis, comportement direct
// habituel. Ne s'applique qu'aux réponses publiques d'un agent dont
// `requiresApproval` est activé.
enum MessageApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Message {
  id             String            @id @default(cuid())
  // Texte brut du message, TOUJOURS renseigné. C'est la version qui sert à tout
  // ce qui n'affiche pas de mise en forme : recherche plein texte de la liste,
  // export CSV, dossier RGPD, contexte envoyé à l'IA, historique repris en bas
  // des emails, et la partie text/plain de l'email lui-même. Quand une réponse
  // est écrite en éditeur riche, c'est la retranscription de `contentHtml`.
  content        String
  // Mise en forme de la réponse, quand elle en a une. Nul sur tout l'historique
  // et sur les messages entrants (un email reçu est réduit à son texte à la
  // synchronisation, voir gmail-sync.ts) : l'affichage retombe alors sur
  // `content`, sans quoi il aurait fallu réécrire les messages déjà en base.
  //
  // Colonne séparée et non un remplacement de `content` : la liste ci-dessus
  // veut du texte, pas des balises à retirer à chaque lecture.
  contentHtml    String?
  authorType     MessageAuthorType
  // Note interne (non visible du client, pas d'envoi d'email) vs réponse
  // publique. Fait déjà office de "is_internal" — pas de champ dupliqué.
  isPrivate      Boolean           @default(false)
  emailSent      Boolean           @default(false) // réponse publique effectivement envoyée par email
  gmailMessageId String?           @unique // id Gmail du message entrant/sortant correspondant (dédoublonnage sync)

  approvalStatus MessageApprovalStatus?
  approvedAt     DateTime?

  createdAt DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  agent   Agent?  @relation(fields: [agentId], references: [id])
  agentId String?

  approvedBy   Agent?  @relation("MessageApprovedBy", fields: [approvedById], references: [id])
  approvedById String?

  // Note interne écrite en réponse à une autre note du même ticket. Sert au fil
  // de discussion, qui affiche la note citée au-dessus de la réponse. Le ping du
  // collègue, lui, reste porté par le « @Prénom Nom » du texte.
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replyToId String?
  replies   Message[] @relation("MessageReply")

  attachments   Attachment[]
  notifications Notification[]

  @@index([ticketId])
  @@index([approvalStatus])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Présence sur une fiche ticket (détection de collision)
// ---------------------------------------------------------------------------

// Qui a ce ticket ouvert en ce moment, et qui y rédige une réponse.
//
// Le problème que ça résout : deux agents ouvrent le même dossier, rédigent
// chacun leur réponse, et le client en reçoit deux — parfois contradictoires. Rien
// dans l'application ne le laissait voir, chaque onglet ignorant tout des autres.
//
// Pourquoi une TABLE et pas un état en mémoire du serveur : l'application peut
// tourner en plusieurs instances (et redémarre à chaque déploiement), or une
// présence gardée en mémoire serait invisible d'une instance à l'autre et perdue
// à chaque redémarrage. La base est le seul endroit que tous les onglets
// partagent. Il n'y a pas de canal temps réel dans ce projet — voir
// `use-background-sync.ts` — la présence est donc relevée par battements
// réguliers, comme le reste de l'arrière-plan.
//
// DEUX HORODATAGES et aucun booléen, c'est le point important : un `isComposing`
// laissé à `true` par un onglet fermé brutalement afficherait « X rédige une
// réponse » indéfiniment, et ce faux positif est exactement ce qui décrédibilise
// ce genre d'indicateur. Une présence n'est vraie que si elle est RÉCENTE ; les
// lignes périmées sont supprimées au passage des battements suivants.
model TicketPresence {
  id String @id @default(cuid())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String

  /// Dernier battement reçu : l'agent avait la fiche ouverte à cet instant.
  seenAt DateTime @default(now())

  /// Dernier battement pendant lequel son champ de réponse n'était pas vide.
  /// Nul dès qu'il vide son brouillon — c'est le battement qui l'efface, pas
  /// l'expiration, pour que l'alerte disparaisse vite chez le collègue.
  composingAt DateTime?

  // Une ligne par agent et par ticket : c'est un état courant, pas un historique.
  // L'historique des consultations, lui, est déjà tenu par le journal d'audit.
  @@unique([ticketId, agentId])
  @@index([ticketId, seenAt])
  // Le ménage porte sur `seenAt` seul (toutes fiches confondues) : sans cet
  // index, il balaierait la table entière à chaque battement.
  @@index([seenAt])
  @@map("ticket_presences")
}

// ---------------------------------------------------------------------------
// Notifications internes (mentions @agent dans les notes internes)
// ---------------------------------------------------------------------------

enum NotificationType {
  MENTION
  // Ticket confié à un agent (bouton d'assignation du panneau d'attributs).
  // Sans cette notification, une réassignation était totalement silencieuse :
  // le ticket changeait de main sans que personne ne l'apprenne.
  ASSIGNMENT
  // Panne d'un service de fond (antivirus pour l'instant). Pas d'auteur ni de
  // ticket : tout le message tient dans `excerpt`.
  SYSTEM_ALERT
  // Règle automatique ayant agi sur un ticket suivi par un groupe. Pas d'auteur
  // — personne ne l'a déclenchée — mais un ticket, contrairement à SYSTEM_ALERT.
  AUTOMATION
}

// Un agent mentionné en @ dans une note interne reçoit à la fois un email et
// une ligne ici, lue par la cloche du dashboard. `excerpt` fige un extrait de
// la note au moment du ping : la cloche reste lisible même si la note est
// réécrite ensuite.
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType @default(MENTION)
  excerpt   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  recipient   Agent  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String

  // Auteur du ping. Optionnel pour survivre à la suppression de son compte —
  // la notification reste consultable, sans nom d'auteur.
  actor   Agent?  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String?

  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String?

  @@index([recipientId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Journal d'audit (qui a consulté, répondu, modifié — et quand)
// ---------------------------------------------------------------------------

// Un geste d'agent tracé. Ajouter une valeur ici impose d'ajouter son entrée
// dans le registre `AUDIT_ACTIONS` de src/lib/audit-actions.ts : c'est le seul
// endroit du code qui sait comment libeller une action et à quelle famille
// (consultation / réponse / modification) elle appartient.
enum AuditAction {
  TICKET_VIEWED // ouverture de la fiche par un agent
  TICKET_CREATED
  TICKET_REPLIED // réponse publique, partie (ou en attente de validation)
  TICKET_NOTE_ADDED // note interne, jamais envoyée au client
  TICKET_UPDATED // statut, priorité, produit, assignation, champs personnalisés
  TICKET_CLAIMED // « Prendre en charge »
  TICKET_CLOSED
  TICKET_DELETED
  TICKET_MERGED
  TICKET_UNMERGED
  REPLY_APPROVED
  REPLY_REJECTED
  // Gestes portant sur les comptes de l'équipe. Ce sont les actions les plus
  // sensibles de l'application — elles décident de qui peut voir et faire quoi
  // — et c'étaient les seules à n'être tracées nulle part.
  AGENT_ACCESS_GRANTED // demande d'accès approuvée
  AGENT_ACCESS_DENIED // demande d'accès refusée
  AGENT_PERMISSIONS_UPDATED // rôle, activation ou permissions fines modifiés
  // Tenue du répertoire client. Tracé parce qu'irréversible : la fusion supprime
  // des fiches et déplace des tickets d'un contact à l'autre, sans qu'aucun
  // écran ne garde ensuite la moindre trace de l'état antérieur.
  CLIENTS_MERGED // fiches contacts en doublon réunies en une seule
  CLIENTS_UNMERGED // fiche détachée du contact qui l'avait absorbée
  // Réponses aux droits d'une personne concernée (RGPD). Ce sont les gestes qui
  // DOIVENT être traçables en priorité : remettre le dossier d'une personne,
  // effacer son identité ou sa fiche sont exactement ce qu'un contrôle demande
  // de prouver. Ils sont donc journalisés comme le reste, sans exception.
  SUBJECT_DATA_EXPORTED // dossier remis à la personne concernée (art. 15 / 20)
  SUBJECT_ANONYMIZED // identité remplacée par un pseudonyme (art. 17)
  SUBJECT_DELETED // fiche supprimée
}

// Une ligne du journal, en AJOUT SEUL — un journal réinscriptible ne prouve rien.
//
// Ce n'est pas seulement une convention de code : la migration
// `20260805170000_audit_log_append_only` installe deux déclencheurs Postgres qui
// refusent tout UPDATE et tout DELETE sur cette table. Prisma ne sait pas décrire
// un déclencheur dans un schéma, donc rien ici ne le laisse voir — d'où ce
// commentaire. Les seules exceptions, et leurs raisons, sont documentées dans le
// SQL de cette migration : le dénouage d'un lien par `onDelete: SetNull`, et une
// purge de conservation qui doit se déclarer explicitement.
//
// La migration `20260807120100_privacy_subject_rights` en ouvre une troisième,
// aussi étroite : la PSEUDONYMISATION d'une personne concernée, qui remplace son
// identité (`actorName`, `actorEmail`, et ses mentions dans `summary`/`changes`)
// par une forme anonyme sans toucher au reste. C'est ce qui permet d'honorer un
// droit à l'effacement tout en conservant le journal : ce qui a été fait, quand
// et sur quel ticket reste immuable, y compris sous ce drapeau.
//
// Conséquence à connaître avant d'écrire du code sur cette table : un
// `prisma.auditLog.update()` ou `.delete()` lèvera une erreur Postgres. C'est
// voulu.
//
// Ce qui est délibérément ABSENT : le corps des messages et la valeur des champs
// personnalisés. Le journal répond à « qui, quoi, quand », pas « qu'a-t-on écrit
// au client » — le fil du ticket est là pour ça. Recopier ces contenus ici
// dupliquerait des données personnelles dans une table conservée même après la
// suppression du ticket (principe de minimisation).
model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  createdAt DateTime    @default(now())

  // --- Qui ---
  // Le lien vers l'agent se dénoue à la suppression du compte (`SetNull`), mais
  // le nom et l'email restent figés : une trace qui perd son auteur ne répond
  // plus à « qui ».
  actor      Agent?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  actorName  String
  actorEmail String

  // --- Sur quoi ---
  // Même raisonnement : le ticket peut être supprimé (`deleteTicket`), son
  // numéro et son sujet sont recopiés pour que la ligne reste lisible ensuite.
  // C'est justement la suppression qu'un journal doit pouvoir raconter.
  ticket        Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  ticketId      String?
  ticketNumber  Int?
  ticketSubject String?

  // --- Quoi exactement ---
  // `changes` porte le détail d'une modification, champ par champ :
  // [{ label, from, to }] — c'est ce qui rend un TICKET_UPDATED vérifiable.
  // `summary` porte la précision d'une action qui n'est pas un différentiel
  // (« réponse envoyée par email », « fusionné dans le ticket #128 »). Les deux
  // ne se recouvrent pas : une action renseigne l'un ou l'autre.
  changes Json    @default("[]")
  summary String?

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([ticketId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Intégration Gmail (une seule boîte support connectée à la fois)
// ---------------------------------------------------------------------------

model EmailAccount {
  id           String    @id @default(cuid())
  email        String    @unique
  accessToken  String
  refreshToken String
  tokenExpiry  DateTime?
  historyId    String? // curseur de synchronisation incrémentale Gmail
  connectedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("email_accounts")
}

// ---------------------------------------------------------------------------
// Paramètres généraux (clé / valeur)
// ---------------------------------------------------------------------------

// Modèle d'email envoyé par le bouton "Clore ce ticket" — singleton (une seule
// ligne, comme EmailAccount). Pas de ligne = pas d'email de clôture envoyé.
model TicketClosureTemplate {
  id        String   @id @default(cuid())
  bodyHtml  String
  updatedAt DateTime @updatedAt

  @@map("ticket_closure_template")
}

// Accusé de réception envoyé au client dès la création d'un ticket depuis un
// formulaire public (portail, widget, sources) — singleton comme
// TicketClosureTemplate. Pas de ligne = aucun accusé envoyé.
model TicketAcknowledgementTemplate {
  id        String   @id @default(cuid())
  bodyHtml  String
  updatedAt DateTime @updatedAt

  @@map("ticket_acknowledgement_template")
}

// Habillage HTML commun à TOUS les emails sortants (en-tête, carte, pied de
// page) — singleton comme les deux modèles ci-dessus. Le contenu propre à
// chaque email s'insère dedans par emplacements ({{content}}, {{headline}}…),
// voir src/lib/email-layout.ts. Pas de ligne = gabarit par défaut du code.
model EmailLayoutTemplate {
  id        String   @id @default(cuid())
  html      String
  updatedAt DateTime @updatedAt

  @@map("email_layout_template")
}

// À qui s'applique une signature.
enum SignatureScope {
  ALL_AGENTS // toute l'équipe, sauf les agents couverts par une signature nominative
  SPECIFIC_AGENTS // uniquement les agents listés dans `agents`
}

// Signature ajoutée en bas des réponses envoyées au client par email, sous le
// corps du message et avant l'historique de la conversation. Le contenu porte
// des variables ({{prenom}}, {{nom}}…) remplies au moment de l'envoi avec
// l'identité de l'agent auteur de la réponse — voir src/lib/signature.ts.
//
// Contrairement aux modèles d'email ci-dessus, ce n'est pas un singleton : une
// signature peut valoir pour toute l'équipe ou pour quelques agents seulement.
// Une signature nominative l'emporte sur celle de toute l'équipe, et un agent
// n'est jamais couvert par deux signatures actives à la fois (garanti à
// l'enregistrement, voir src/lib/actions/signatures.ts).
model EmailSignature {
  id       String         @id @default(cuid())
  name     String         @unique
  bodyHtml String
  scope    SignatureScope @default(ALL_AGENTS)
  isActive Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Agents concernés quand `scope` vaut SPECIFIC_AGENTS. Ignoré (et vidé à
  // l'enregistrement) pour une signature de toute l'équipe.
  agents Agent[]

  @@index([isActive])
  @@map("email_signatures")
}

enum PortalColorMode {
  LIGHT
  DARK
}

// Disposition de la barre de navigation du portail.
enum PortalNavVariant {
  LOGO_LEFT // logo à gauche, liens + CTA à droite
  LINKS_CENTER // logo à gauche, liens centrés, CTA à droite
  CENTERED // logo centré, liens sur une seconde ligne centrée
  MINIMAL // logo à gauche, seulement le CTA à droite
}

enum PortalAlign {
  LEFT
  CENTER
}

// Portail public (accueil, FAQ, création de ticket) — singleton, comme
// EmailAccount et TicketClosureTemplate. Pas de ligne = toutes les valeurs par
// défaut ci-dessous (voir aussi PORTAL_DEFAULTS dans src/lib/portal-theme.ts,
// qui doit rester aligné avec ces @default).
model PortalSettings {
  id String @id @default(cuid())

  // --- Identité ---
  siteName        String  @default("Ideeri")
  tagline         String? @default("Support")
  showTagline     Boolean @default(true)
  showLogo        Boolean @default(true)
  showSiteName    Boolean @default(false)
  logoAssetId     String?
  logoHeight      Int     @default(24) // hauteur d'affichage du logo, en px
  faviconAssetId  String?
  metaTitle       String?
  metaDescription String?

  // --- Apparence --- (couleurs en hex ; null = valeur par défaut du thème)
  colorMode              PortalColorMode @default(LIGHT)
  primaryColor           String          @default("#ecb300")
  primaryForegroundColor String          @default("#0a0a0a")
  backgroundColor        String?
  foregroundColor        String?
  cardColor              String?
  borderColor            String?
  mutedColor             String?
  mutedForegroundColor   String?
  radius                 Float           @default(0.5) // en rem
  fontSans               String          @default("inter")
  fontDisplay            String          @default("fraunces")

  // --- Navigation --- navLinks : [{ label, href, newTab }]
  navVariant    PortalNavVariant @default(LOGO_LEFT)
  navSticky     Boolean          @default(true)
  navBlur       Boolean          @default(true)
  navBordered   Boolean          @default(true)
  navShowFaq    Boolean          @default(true)
  navShowLogin  Boolean          @default(true)
  navCtaEnabled Boolean          @default(true)
  navCtaLabel   String           @default("Créer un ticket")
  navLinks      Json             @default("[]")

  // --- Hero ---
  heroEnabled  Boolean     @default(true)
  heroEyebrow  String?     @default("Centre d'aide Ideeri")
  heroTitle    String?     @default("Comment pouvons-nous vous aider ?")
  introMessage String? // sous-titre du hero, aussi réutilisé sur /nouveau-ticket
  heroAlign    PortalAlign @default(CENTER)
  heroGlow     Boolean     @default(true)

  // --- Cartes « deux chemins » --- (icônes : noms lucide de PORTAL_ICONS)
  cardsEnabled    Boolean @default(true)
  faqCardTitle    String  @default("Consulter la FAQ")
  faqCardText     String  @default("Les réponses aux questions les plus fréquentes sur nos logiciels, classées par produit.")
  faqCardIcon     String  @default("BookOpen")
  ticketCardTitle String  @default("Créer un ticket")
  ticketCardText  String  @default("Une question précise ou un problème ? Décrivez votre demande, nous vous répondons par email.")
  ticketCardIcon  String  @default("MessagesSquare")

  // --- Section FAQ ---
  faqEnabled       Boolean @default(true)
  faqEyebrow       String? @default("Foire aux questions")
  faqTitle         String? @default("Trouvez votre réponse")
  faqSearchEnabled Boolean @default(true)

  // --- Pied de page --- footerLinks : [{ label, href, newTab }]
  footerEnabled Boolean @default(true)
  footerText    String? @default("Support Ideeri")
  footerIcon    String  @default("LifeBuoy")
  footerLinks   Json    @default("[]")

  updatedAt DateTime @updatedAt

  @@map("portal_settings")
}

// Visuels publics (logo et favicon du portail, en-tête des formulaires de
// source), stockés en base comme KnowledgeArticleImage — pas de disque
// persistant en production — et servis par /api/portal/assets/[id].
model PortalAsset {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  scanStatus    FileScanStatus @default(PENDING)
  scanSignature String?
  scannedAt     DateTime?

  @@index([scanStatus])
  @@map("portal_assets")
}

model GlobalSetting {
  key         String   @id
  value       String
  label       String
  description String?
  multiline   Boolean  @default(false) // affiche un textarea plutôt qu'un input dans /settings/general
  updatedAt   DateTime @updatedAt

  @@map("global_settings")
}

// ---------------------------------------------------------------------------
// Battements des tâches planifiées
// ---------------------------------------------------------------------------

// Une ligne par tâche déclenchée de l'extérieur. L'ordonnanceur vit hors de
// l'app : quand il tombe, ou quand l'app répond 502 pendant un redéploiement,
// aucun code d'ici ne s'exécute pour le signaler. La panne se déduit donc de
// l'absence de battement, comparée à l'intervalle attendu au moment de la
// lecture (voir src/lib/cron-heartbeat.ts).
model CronHeartbeat {
  job String @id

  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  // Cause du dernier échec, reprise telle quelle dans la notification.
  lastDetail    String?

  // Épisode de panne déjà signalé aux agents. Remis à null par le premier
  // passage sain : sans ça, une panne de trois jours renotifierait à chaque
  // relève de la cloche, toutes les minutes et pour chaque agent connecté.
  alertedAt DateTime?

  updatedAt DateTime @updatedAt

  @@map("cron_heartbeats")
}

// ---------------------------------------------------------------------------
// Base de connaissances (FAQ) & modèles d'articles
// ---------------------------------------------------------------------------

enum KnowledgeArticleStatus {
  DRAFT
  PUBLISHED
}

model KnowledgeCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles KnowledgeArticle[]

  @@map("knowledge_categories")
}

model KnowledgeArticle {
  id          String                 @id @default(cuid())
  title       String
  slug        String                 @unique
  excerpt     String?
  content     String
  status      KnowledgeArticleStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  category   KnowledgeCategory? @relation(fields: [categoryId], references: [id])
  categoryId String?

  // Lien de partage optionnel — absent tant que l'auteur n'a pas activé le
  // partage. `shareScope` choisit au cas par cas si le lien est consultable
  // sans connexion (PUBLIC) ou seulement par un agent connecté (INTERNAL).
  shareToken String?              @unique
  shareScope KnowledgeShareScope?

  @@index([categoryId])
  @@index([status])
  @@map("knowledge_articles")
}

enum KnowledgeShareScope {
  PUBLIC
  INTERNAL
}

// Images insérées dans le contenu riche d'un article — stockées en base
// comme les pièces jointes de ticket (pas de stockage fichier persistant
// simple sur Railway). Pas de FK vers l'article : une image reste valide même
// déplacée entre articles ou collée avant la première sauvegarde.
model KnowledgeArticleImage {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  scanStatus    FileScanStatus @default(PENDING)
  scanSignature String?
  scannedAt     DateTime?

  @@index([scanStatus])
  @@map("knowledge_article_images")
}

// Trames réutilisables pour rédiger un nouvel article plus vite (pas liées à
// un article précis : appliquer un modèle copie simplement son contenu dans
// l'éditeur, l'agent part de là).
model ArticleTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("article_templates")
}

// ---------------------------------------------------------------------------
// Automatisations (ex : fermeture automatique des tickets inactifs)
// ---------------------------------------------------------------------------

model AutomationRule {
  id       String  @id @default(cuid())
  name     String
  isActive Boolean @default(true)

  // Délai d'inactivité (basé sur `Ticket.updatedAt`) avant que la règle ne
  // s'applique à un ticket dans le statut déclencheur. En minutes : une
  // escalade sur les tickets urgents se compte en heures, pas en jours.
  delayMinutes Int @default(4320)

  triggerStatus   TicketStatus @relation("AutomationTriggerStatus", fields: [triggerStatusId], references: [id])
  triggerStatusId String

  // Priorités concernées, liste vide = toutes. Des ids plutôt qu'une relation :
  // supprimer une priorité retire la règle de la circulation au lieu de vider
  // son filtre, ce qu'un ON DELETE CASCADE ferait en l'élargissant à tous les
  // tickets du statut.
  triggerPriorityIds String[] @default([])

  // Produits concernés, liste vide = tous. Même choix que les priorités.
  triggerCategoryIds String[] @default([])

  // Filtres qui ne se déduisent d'aucune liste administrable.
  //
  // `onlyUnanswered` est celui qui manquait le plus : « sans activité » compte
  // n'importe quel mouvement sur le ticket, y compris une note interne, alors
  // que la règle qu'on veut écrire est « personne n'a répondu au client ».
  onlyUnanswered  Boolean @default(false)
  onlyUnassigned  Boolean @default(false)
  onlyBreachedSla Boolean @default(false)

  actionStatus   TicketStatus @relation("AutomationActionStatus", fields: [actionStatusId], references: [id])
  actionStatusId String

  // Actions facultatives : `null` = ne pas y toucher. Le changement de statut
  // reste obligatoire, c'est lui qui sort le ticket du filtre de la règle et la
  // rend rejouable sans registre (voir `runAutomations`).
  actionPriority   TicketPriority? @relation("AutomationActionPriority", fields: [actionPriorityId], references: [id])
  actionPriorityId String?

  actionAssignee   Agent?  @relation("AutomationActionAssignee", fields: [actionAssigneeId], references: [id])
  actionAssigneeId String?

  // Prévenir un groupe au lieu de confier le ticket à quelqu'un : un ticket n'a
  // qu'un assigné, un groupe en compte plusieurs. Ses membres reçoivent cloche
  // et email, le ticket reste non assigné. Exclusif de `actionAssigneeId`.
  actionNotifyGroup   Group?  @relation("AutomationNotifyGroup", fields: [actionNotifyGroupId], references: [id])
  actionNotifyGroupId String?

  addNote     Boolean @default(true)
  noteContent String  @default("Ticket automatiquement fermé après inactivité.")

  sendEmail    Boolean @default(false)
  // Deux formes du même message : `emailContent` est la partie text/plain,
  // `emailHtml` la mise en forme saisie dans l'éditeur. L'habillage de
  // /settings/email-layout est appliqué à l'envoi, pas stocké ici.
  emailContent String?
  emailHtml    String?

  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("automation_rules")
}
